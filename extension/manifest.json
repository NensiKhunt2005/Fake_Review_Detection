{
    "manifest_version": 3,
    "name": "Fake Review Detector",
    "version": "1.0",
    "description": "AI-powered review trust analysis for Amazon and Flipkart product pages.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://amazon.com/*",
                "https://*.amazon.com/*",
                "https://amazon.in/*",
                "https://*.amazon.in/*",
                "https://flipkart.com/*",
                "https://*.flipkart.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*",
        "https://amazon.in/*",
        "https://*.amazon.in/*",
        "https://flipkart.com/*",
        "https://*.flipkart.com/*"
    ]
}
