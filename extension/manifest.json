{
    "manifest_version": 3,
    "name": "Fake Review Detector",
    "version": "1.0",
    "description": "Universal fake review detection for all e-commerce websites.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "<all_urls>"
    ]
}